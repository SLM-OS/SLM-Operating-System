diff --git a/kernel/include/pd_witness.h b/kernel/include/pd_witness.h
new file mode 100644
index 00000000..e0cc959c
--- /dev/null
+++ b/kernel/include/pd_witness.h
@@ -0,0 +1,61 @@
+/*
+ * pd_witness.h - preempt_disabled[] witness at the resume point of
+ * schedule() (#1284). Build option PD_WITNESS, default OFF; with it off
+ * this header defines only empty macros and the kernel's .text is
+ * unchanged.
+ *
+ * What the design says (ADR 0008, #1229's fix in schedule()):
+ *
+ *  W1, "resume": when switch_to() returns on the incoming task, the CPU
+ *    the task is now running on is the CPU that switched it in. That CPU
+ *    set preempt_disabled[cpu] = 1 before its switch window (schedule(),
+ *    or scheduler_start() for the first switch), with its CPU id pinned
+ *    under masked interrupts (#1242), and nothing clears it before this
+ *    task clears it: ticks skip schedule() and the trampoline does not
+ *    arm while it is 1, so the task cannot move. So, read with local
+ *    interrupts masked, preempt_disabled[cpu_id()] must be 1 here. A 0
+ *    means another CPU cleared this CPU's flag inside its window (the
+ *    #1229 defect class) or the flag was set on a different CPU from the
+ *    one that switched the task in.
+ *
+ *  W2, "exit": right after schedule() clears preempt_disabled[now_cpu]
+ *    (now_cpu re-read with cpu_id(), #1229), the flag of the CPU the task
+ *    is running on, read with local interrupts masked and the CPU id
+ *    re-read independently, must be 0. Only this CPU writes its own flag
+ *    on these paths; a tick between the clear and the masked read runs
+ *    the trampoline to completion, which leaves 0 on the CPU it returns
+ *    on. A 1 means the clear went to another CPU's flag (the reverted
+ *    #1229 line does exactly that), or another CPU set this CPU's flag.
+ *
+ * W1 and W2 run only on the path where schedule() switched and is
+ * resuming, not on its early return (no switch) and not on a new task's
+ * first run (task_entry_trampoline clears the flag there).
+ *
+ * Violations are counted per CPU and kind; the first three are printed
+ * at once with the CPU, the task, the expected and the observed value.
+ * pd_witness_report() prints the totals (the test harness calls it after
+ * a filtered run).
+ */
+#ifndef PD_WITNESS_H
+#define PD_WITNESS_H
+
+#include <stdint.h>
+
+#if defined(CONFIG_PD_WITNESS)
+struct pd_witness_totals {
+    uint64_t checks;            /* W1 checks, all CPUs (W2 runs as often) */
+    uint64_t viol_resume;       /* W1 violations, all CPUs */
+    uint64_t viol_exit;         /* W2 violations, all CPUs */
+};
+void pd_witness_resume(void);
+void pd_witness_exit(void);
+void pd_witness_totals(struct pd_witness_totals *out);
+void pd_witness_report(const char *tag);
+#define PD_WITNESS_RESUME()     pd_witness_resume()
+#define PD_WITNESS_EXIT()       pd_witness_exit()
+#else
+#define PD_WITNESS_RESUME()     do { } while (0)
+#define PD_WITNESS_EXIT()       do { } while (0)
+#endif
+
+#endif /* PD_WITNESS_H */
diff --git a/kernel/sched/sched.c b/kernel/sched/sched.c
index 7436bda9..ad3ea3e5 100644
--- a/kernel/sched/sched.c
+++ b/kernel/sched/sched.c
@@ -38,6 +38,7 @@
 #endif
 #include "slot_trace.h"
 #include "switch_check.h"
+#include "pd_witness.h"
 /* Unconditional: the #1216 window hooks and their STEAL_WIN_* reasons
  * are referenced from schedule() in every configuration (they are
  * empty functions without work stealing). */
@@ -218,6 +219,78 @@ static inline irq_flags_t sched_irq_save(void)
 #endif
 }
 
+#if defined(CONFIG_PD_WITNESS)
+/* preempt_disabled[] witness at schedule()'s resume point (#1284); the
+ * invariants are stated in pd_witness.h. */
+static volatile uint64_t pdw_checks[MAX_CPUS];
+static volatile uint32_t pdw_viol[2][MAX_CPUS];     /* [0] W1 resume, [1] W2 exit */
+static volatile uint32_t pdw_printed;
+
+static void pdw_record(uint32_t kind, uint32_t cpu, int expected, int observed)
+{
+    __atomic_fetch_add(&pdw_viol[kind][cpu], 1, __ATOMIC_RELAXED);
+    if (__atomic_fetch_add(&pdw_printed, 1, __ATOMIC_RELAXED) < 3) {
+        struct task *t = task_current();
+        uart_printf("\n[PDW] violation %s: cpu=%u task id=%u name='%s' "
+                    "preempt_disabled expected=%d observed=%d\n",
+                    kind == 0 ? "resume" : "exit", cpu,
+                    t ? (unsigned int)t->id : 0u, t ? t->name : "(none)",
+                    expected, observed);
+    }
+}
+
+void pd_witness_resume(void)
+{
+    irq_flags_t f = sched_irq_save();
+    uint32_t cpu = cpu_id();
+    int v = preempt_disabled[cpu];
+    irq_restore(f);
+    pdw_checks[cpu]++;                  /* only this CPU writes its slot */
+    if (v != 1) {
+        pdw_record(0, cpu, 1, v);
+    }
+}
+
+void pd_witness_exit(void)
+{
+    irq_flags_t f = sched_irq_save();
+    uint32_t cpu = cpu_id();
+    int v = preempt_disabled[cpu];
+    irq_restore(f);
+    if (v != 0) {
+        pdw_record(1, cpu, 0, v);
+    }
+}
+
+void pd_witness_totals(struct pd_witness_totals *out)
+{
+    out->checks = 0;
+    out->viol_resume = 0;
+    out->viol_exit = 0;
+    for (uint32_t c = 0; c < MAX_CPUS; c++) {
+        out->checks += pdw_checks[c];
+        out->viol_resume += pdw_viol[0][c];
+        out->viol_exit += pdw_viol[1][c];
+    }
+}
+
+void pd_witness_report(const char *tag)
+{
+    struct pd_witness_totals t;
+    pd_witness_totals(&t);
+    uart_printf("[PDW] %s: checks=%lu violations resume=%lu exit=%lu\n",
+                tag, (unsigned long)t.checks, (unsigned long)t.viol_resume,
+                (unsigned long)t.viol_exit);
+    for (uint32_t c = 0; c < MAX_CPUS; c++) {
+        if (pdw_checks[c] == 0 && pdw_viol[0][c] == 0 && pdw_viol[1][c] == 0) {
+            continue;
+        }
+        uart_printf("[PDW]   cpu%u: checks=%lu resume=%u exit=%u\n", c,
+                    (unsigned long)pdw_checks[c], pdw_viol[0][c], pdw_viol[1][c]);
+    }
+}
+#endif /* CONFIG_PD_WITNESS */
+
 /*
  * Per-CPU run queue access. The run queues live in cacheable BSS
  * (sched.cpu_fallback) on every platform.
@@ -2943,6 +3016,7 @@ relock:
                next->context.x19);
     struct task *prev = switch_to(current, next);
     sched_finish_switch(prev);
+    PD_WITNESS_RESUME();            /* #1284; empty unless PD_WITNESS */
 
 #if !defined(PLATFORM_X86_64)
     SLOT_TRACE_ONLY({
@@ -2964,6 +3038,7 @@ relock:
     uint32_t now_cpu = cpu_id();
     SLOT_TRACE(ST_PD_CLEAR, task_current(), now_cpu, now_cpu, this_cpu);
     preempt_disabled[now_cpu] = 0;
+    PD_WITNESS_EXIT();              /* #1284; empty unless PD_WITNESS */
     SWO_PHASE(now_cpu, SWO_PH_NONE, 0);
     steal_pdwin_clear(now_cpu);                     /* #1216 trace */
 #if defined(SECONDARY_PREEMPT)
