 /* ============================================================================
@@ -518,9 +519,22 @@ static int harness_run_filtered(void)
         }
     }
 
+#if defined(CONFIG_PD_WITNESS)
+    uint64_t pdw_seen = 0;
+#endif
     for (uint32_t pass = 1; pass <= f->repeat; pass++) {
         g_test_filter_pass = pass;
         total_failures += harness_run_suites();
+#if defined(CONFIG_PD_WITNESS)
+        /* #1284: name the pass in which the witness count changed. */
+        struct pd_witness_totals pdw;
+        pd_witness_totals(&pdw);
+        if (pdw.viol_resume + pdw.viol_exit != pdw_seen) {
+            pdw_seen = pdw.viol_resume + pdw.viol_exit;
+            uart_printf("[PDW] count changed in pass %u\n", pass);
+            pd_witness_report("after pass");
+        }
+#endif
     }
 
     uint64_t freq = timer_get_frequency();
@@ -620,6 +634,10 @@ void test_harness_register_shell(void)
 
 static int test_harness_finish(int total_failures)
 {
+#if defined(CONFIG_PD_WITNESS)
+    uart_puts("\n");
+    pd_witness_report("end of run");    /* #1284 */
+#endif
     /* Final summary */
     uart_puts("\n");
     uart_puts("========================================\n");
