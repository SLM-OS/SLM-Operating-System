From ee2f9c974ebfc56681342a66fc6355945e8a1c47 Mon Sep 17 00:00:00 2001
From: John Jezl <john@jezl.com>
Date: Tue, 10 Nov 2026 01:02:17 -0800
Subject: [PATCH] TEMPORARY, NOT FOR MERGE: forced-remote #1205 discriminator

Coherency run 2, C1. Adds test_component_cleanup_forced_remote_1205: the
c4 multi-task cleanup wait with its original 1,000-yield bound, the three
tasks pinned to CPUs 1 to 3 so every cleanup takes the remote path, 20
iterations per boot, one row per iteration with the cleanup count at the
bound and re-polled 1, 10 and 100 ms after it, and when all three fired.

Refs #1205, #1193.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel/tests/test_component.c | 142 ++++++++++++++++++++++++++++++++++
 1 file changed, 142 insertions(+)

diff --git a/kernel/tests/test_component.c b/kernel/tests/test_component.c
index 0ecb02de..85192f1f 100644
--- a/kernel/tests/test_component.c
+++ b/kernel/tests/test_component.c
@@ -12,6 +12,8 @@
 #include "task.h"
 #include "sched.h"
 #include "test_wait.h"
+#include "smp.h"
+#include "timer.h"
 #include <stdint.h>
 #include <stddef.h>
 
@@ -509,6 +511,145 @@ static void test_component_cleanup_ctx_is_per_task(void)
     }
 }
 
+/* ============================================================================
+ * TEMPORARY, NOT FOR MERGE: #1205 discriminator (coherency run 2, C1).
+ *
+ * The same wait as test_component_cleanup_ctx_is_per_task with its original
+ * bound of 1,000 yield() calls, but each of the three tasks is pinned to one
+ * of CPUs 1 to 3, so every cleanup takes the remote path (the task must be
+ * dispatched to an idle CPU, run, exit and be reaped there) while the waiter
+ * on CPU 0 yields with nothing else queued. Runs F1205_ITERS iterations and
+ * logs one row per iteration: waiter CPU, yields spent, wall time of the
+ * wait, the cleanup count at the bound and re-polled 1, 10 and 100 ms after
+ * it (load-acquire, yielding), and when all three cleanups had fired. A
+ * timeout whose cleanups fire after the bound shows the bound is a timing
+ * artifact; cleanups that never fire would be a lost cleanup.
+ * ============================================================================ */
+#define F1205_ITERS 20
+#define F1205_N     3
+
+static volatile int f1205_done;
+static volatile uint32_t f1205_ran_cpu[F1205_N];
+static volatile uint64_t f1205_ran_ts[F1205_N];
+static volatile uint32_t f1205_cl_cpu[F1205_N];
+static volatile uint64_t f1205_cl_ts[F1205_N];
+
+static long long f1205_us(uint64_t a, uint64_t b)
+{
+    uint64_t f = timer_get_frequency();
+    if (b == 0 || b < a || f == 0) {
+        return -1;
+    }
+    return (long long)((b - a) * 1000000ull / f);
+}
+
+static void f1205_entry(void *arg)
+{
+    int slot = (int)(uintptr_t)arg;
+    f1205_ran_ts[slot] = timer_get_count();
+    f1205_ran_cpu[slot] = cpu_id();
+}
+
+static void f1205_cleanup(void *arg)
+{
+    int slot = (int)(uintptr_t)arg;
+    f1205_cl_ts[slot] = timer_get_count();
+    f1205_cl_cpu[slot] = cpu_id();
+    __atomic_fetch_add(&f1205_done, 1, __ATOMIC_RELEASE);
+}
+
+static void test_component_cleanup_forced_remote_1205(void)
+{
+    if (cpu_count < 4) {
+        TEST_IGNORE_MESSAGE("needs CPUs 1 to 3");
+        return;
+    }
+    int hit_bound = 0;
+    int never = 0;
+    int ran = 0;
+    for (int it = 0; it < F1205_ITERS; it++) {
+        ran++;
+        f1205_done = 0;
+        for (int i = 0; i < F1205_N; i++) {
+            f1205_ran_cpu[i] = 0xFFu;
+            f1205_ran_ts[i] = 0;
+            f1205_cl_cpu[i] = 0xFFu;
+            f1205_cl_ts[i] = 0;
+        }
+        uint32_t waiter_cpu = cpu_id();
+        uint64_t t_dispatch = timer_get_count();
+        for (int i = 0; i < F1205_N; i++) {
+            struct task *t = task_create("f1205", f1205_entry,
+                                         (void *)(uintptr_t)i);
+            TEST_ASSERT_NOT_NULL(t);
+            task_set_cleanup(t, f1205_cleanup, (void *)(uintptr_t)i);
+            task_set_affinity(t, (uint32_t)i + 1u);
+            scheduler_add_task_to_cpu(t, (uint32_t)i + 1u);
+        }
+        uint64_t t_loop = timer_get_count();
+        int timeout = 1000;
+        while (__atomic_load_n(&f1205_done, __ATOMIC_ACQUIRE) < F1205_N
+               && timeout > 0) {
+            yield();
+            timeout--;
+        }
+        uint64_t t_end = timer_get_count();
+        int at_bound = __atomic_load_n(&f1205_done, __ATOMIC_ACQUIRE);
+        int yields = 1000 - timeout;
+
+        int rp[3] = { -1, -1, -1 };
+        long long all_after_us = -1;
+        if (timeout <= 0) {
+            static const long long marks_us[3] = { 1000, 10000, 100000 };
+            int next = 0;
+            for (;;) {
+                long long dt = f1205_us(t_end, timer_get_count());
+                int v = __atomic_load_n(&f1205_done, __ATOMIC_ACQUIRE);
+                if (v >= F1205_N && all_after_us < 0) {
+                    all_after_us = dt;
+                }
+                while (next < 3 && dt >= marks_us[next]) {
+                    rp[next++] = v;
+                }
+                if (next >= 3 && (all_after_us >= 0 || dt >= 1000000)) {
+                    break;
+                }
+                yield();
+            }
+            hit_bound++;
+            if (all_after_us < 0) {
+                never++;
+            }
+        }
+        uart_printf("[C1-F1205] it=%d %s waiter_cpu=%u done_at_bound=%d/%d "
+                    "yields=%d/1000 loop_us=%lld repoll 1ms=%d 10ms=%d "
+                    "100ms=%d all_done_after_expiry_us=%lld\n",
+                    it, timeout > 0 ? "PASS" : "FAIL", (unsigned)waiter_cpu,
+                    at_bound, F1205_N, yields, f1205_us(t_loop, t_end),
+                    rp[0], rp[1], rp[2], all_after_us);
+        for (int i = 0; i < F1205_N; i++) {
+            uart_printf("[C1-F1205] it=%d slot %d ran_cpu=%u ran_us=%lld "
+                        "cleanup_cpu=%u cleanup_us=%lld (from dispatch; "
+                        "expiry at %lld)\n",
+                        it, i, (unsigned)f1205_ran_cpu[i],
+                        f1205_us(t_dispatch, f1205_ran_ts[i]),
+                        (unsigned)f1205_cl_cpu[i],
+                        f1205_us(t_dispatch, f1205_cl_ts[i]),
+                        f1205_us(t_dispatch, t_end));
+        }
+        if (__atomic_load_n(&f1205_done, __ATOMIC_ACQUIRE) < F1205_N) {
+            /* A cleanup is still outstanding after 1 s: stop here rather
+             * than let the next iteration's counter mix with it. */
+            break;
+        }
+    }
+    uart_printf("[C1-F1205] summary: %d of %d iterations hit the 1000-yield "
+                "bound, %d never completed within 1 s\n",
+                hit_bound, ran, never);
+    TEST_ASSERT_MESSAGE(hit_bound == 0,
+        "forced-remote c4 wait hit the 1000-yield bound (#1205 discriminator)");
+}
+
 /* ============================================================================
  * Helper Function Tests
  * ============================================================================ */
@@ -584,6 +725,7 @@ int test_suite_component(void)
     /* Cleanup ctx lifecycle (IPC-C4 regression) */
     RUN_TEST(test_component_cleanup_ctx_payload_preserved);
     RUN_TEST(test_component_cleanup_ctx_is_per_task);
+    RUN_TEST(test_component_cleanup_forced_remote_1205);  /* TEMPORARY, C1 run 2 */
 
     /* Helper function tests */
     RUN_TEST(test_component_state_name);
-- 
