+## Sustained supply, share assertion and idle wakes (#1203, #1216)
+
+The 16-task burst drains CPU 1's deque in a few milliseconds, so a
+thief that woke late fails every attempt whether or not anything is
+wrong. `bench stealing --sustain [ms] [--depth D] [--work W]` keeps D
+tasks (default 16) outstanding on CPU 1 for ms milliseconds (default
+2500): the shell on CPU 0 re-issues a task into each slot as soon as
+the slot reports done, and each task runs W (default 8) burst work
+units. Burst and sustained runs both print a `c2t-format v2` header and
+one `c2t cpu=` line per CPU with every failed attempt's reason, CPU 1's
+`preempt_disabled` windows and each thief's tick phase
+(`kernel/sched/steal_trace.h` documents the fields).
+
+**`--assert-shares`** (sustained runs only) turns the per-CPU
+distribution into a verdict. CPU 1 is the owner; every other online
+CPU is a thief. A thief's share is the tasks it executed over all
+tasks executed in the run. The run fails, printing one
+`ASSERT-SHARES: FAIL ...` line and returning a nonzero shell status,
+when any thief's share is below half the best thief's share (the line
+names the lowest thief, its share, the best thief and its share, and
+every thief below half), when no thief executed a task, or when the
+run timed out (30 s after the supply ended). Otherwise it prints
+`ASSERT-SHARES: PASS` with the lowest and best thief. The decision is
+`steal_shares_check()` in `kernel/sched/steal_trace.h`, covered by
+`kernel/tests/test_steal_shares.c`. On jetson-nano-2 the #1216 stall
+left CPUs 2 and 3 (the owner's cluster) at 0.40 to 0.83 of the best
+thief's median share, and at 0 tasks in some runs (coherency run 3,
+`critic-3-C2.md` section 3).
+
+**Idle wakes.** A sustained run also prints one `iw mode=sustained`
+line per CPU: the idle-loop passes (`sched_diag_idle_loops`) and timer
+ticks during the run, with their rates per second. `bench idle-wakes
+[ms]` measures the same at rest: it sleeps the shell for ms (default
+5000, range 100 to 60000) so CPU 0 idles as well and prints one
+`iw mode=rest` line per CPU. Each pass of the idle loop is one return
+from its wait instruction, so `idle_per_s` is the idle wake rate. On a
+100 Hz tick, a CPU that wakes only on its tick shows `idle_per_s` close
+to `ticks_per_s`; the excess is wakes from other events (SEV, device
+interrupts). This is the cost side of waiting in WFE instead of WFI,
+since every SEV any CPU issues wakes every CPU waiting in WFE.
+
 ## S4 status — default flipped (2026-04-14, Jetson follow-up 2026-04-15)
 
 After hardware capture, `ENABLE_WORK_STEALING` defaults **ON** in
diff --git a/kernel/sched/steal_trace.h b/kernel/sched/steal_trace.h
index cc138191..2cd64d89 100644
--- a/kernel/sched/steal_trace.h
+++ b/kernel/sched/steal_trace.h
@@ -185,4 +185,84 @@ void steal_pdwin_tick(uint32_t cpu);
 void steal_pdwin_set_tick_asm(uint32_t cpu);
 void steal_pdwin_clear_asm(uint32_t cpu);
 
+/*
+ * `bench stealing --sustain --assert-shares` decision (#1216).
+ *
+ * exec[c] is the number of tasks CPU c executed in the run, for the
+ * ncpu online CPUs. The owner is the CPU every task was pushed to;
+ * every other online CPU is a thief. A thief's share is exec[c] over
+ * the sum of exec[] over all CPUs, so comparing two thieves' shares is
+ * comparing their exec counts. The run fails when:
+ *   - it timed out (STEAL_SHARES_TIMEOUT), or
+ *   - there is no thief, or no thief executed a task
+ *     (STEAL_SHARES_NO_THIEF), or
+ *   - some thief's share is below half the best thief's share, that
+ *     is 2 * exec[c] < exec[best] (STEAL_SHARES_LOW). Exactly half
+ *     passes.
+ * The owner is never compared. best_cpu is the thief with the most
+ * tasks and worst_cpu the thief with the fewest (ties: the lowest CPU
+ * number). below_mask has bit c set for every thief below half the
+ * best (CPUs 0 to 31). Timeout takes precedence over the other
+ * failures; the CPU fields are filled in either way so the caller can
+ * print them. Pure: no globals, no side effects.
+ */
+#define STEAL_SHARES_PASS      0u
+#define STEAL_SHARES_LOW       1u
+#define STEAL_SHARES_TIMEOUT   2u
+#define STEAL_SHARES_NO_THIEF  3u
+#define STEAL_SHARES_MAX_CPUS  32u
+
+struct steal_shares_verdict {
+    uint32_t result;      /* STEAL_SHARES_*                          */
+    uint32_t best_cpu;    /* thief with the highest exec             */
+    uint32_t worst_cpu;   /* thief with the lowest exec              */
+    uint32_t below_mask;  /* bit c: thief c below half of best_cpu   */
+    uint32_t nthieves;    /* thieves compared                        */
+    uint32_t total;       /* sum of exec over all CPUs (the share
+                             denominator)                            */
+};
+
+static inline struct steal_shares_verdict
+steal_shares_check(const uint32_t *exec, uint32_t ncpu, uint32_t owner,
+                   int timed_out)
+{
+    struct steal_shares_verdict v = {
+        STEAL_SHARES_NO_THIEF, owner, owner, 0, 0, 0
+    };
+    if (ncpu > STEAL_SHARES_MAX_CPUS) {
+        ncpu = STEAL_SHARES_MAX_CPUS;
+    }
+    for (uint32_t c = 0; c < ncpu; c++) {
+        v.total += exec[c];
+        if (c == owner) {
+            continue;
+        }
+        if (v.nthieves == 0 || exec[c] > exec[v.best_cpu]) {
+            v.best_cpu = c;
+        }
+        if (v.nthieves == 0 || exec[c] < exec[v.worst_cpu]) {
+            v.worst_cpu = c;
+        }
+        v.nthieves++;
+    }
+    if (v.nthieves != 0) {
+        uint64_t best = exec[v.best_cpu];
+        for (uint32_t c = 0; c < ncpu; c++) {
+            if (c != owner && 2ULL * exec[c] < best) {
+                v.below_mask |= 1u << c;
+            }
+        }
+    }
+    if (timed_out) {
+        v.result = STEAL_SHARES_TIMEOUT;
+    } else if (v.nthieves == 0 || exec[v.best_cpu] == 0) {
+        v.result = STEAL_SHARES_NO_THIEF;
+    } else if (v.below_mask != 0) {
+        v.result = STEAL_SHARES_LOW;
+    } else {
+        v.result = STEAL_SHARES_PASS;
+    }
+    return v;
+}
+
 #endif /* SCHED_STEAL_TRACE_H */
