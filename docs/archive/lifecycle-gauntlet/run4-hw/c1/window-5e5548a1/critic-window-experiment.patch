@@ -2541,6 +2544,18 @@ void schedule(void)
 
     rq_unlock_irqrestore(this_cpu, flags);
 
+    /* CRITIC EXPERIMENT (not part of any branch): hold the switch window
+     * open for 25 ms for one chosen outgoing task, with the IRQ state the
+     * caller had, so that a timer tick lands inside it. */
+    if (critic_widen_on && current && current == critic_widen_task &&
