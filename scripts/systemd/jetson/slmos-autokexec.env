# /etc/default/slmos-autokexec
#
# Kernel image passed to /usr/local/bin/slmos-kexec when the Jetson is
# booted via the "Linux -> auto-kexec SLM-OS" extlinux entry.
SLMOS_KERNEL=/root/slmos.elf

# Optional extra flags for slmos-kexec, for example:
#   SLMOS_KEXEC_ARGS=--no-gpu-suspend
SLMOS_KEXEC_ARGS=

# Channel-inherit helpers slmos-kexec auto-starts before kexec: a comma
# list of mnist, sched, eviction, or "none". Unset keeps the historical
# default (mnist,sched). Add "eviction" to stage the eviction producer
# too; several preserved channels coexist since #1032. Check the
# resolved value with `slmos-kexec --print-helpers`.
#SLMOS_HELPERS=mnist,sched,eviction
