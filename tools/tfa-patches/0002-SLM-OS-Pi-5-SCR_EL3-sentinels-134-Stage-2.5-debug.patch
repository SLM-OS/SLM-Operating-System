From 0df65c5ca117a23dd6e2f28006c30168e8b0f185 Mon Sep 17 00:00:00 2001
From: slmos-build <slmos-build@example.com>
Date: Wed, 6 May 2026 17:02:18 -0700
Subject: [PATCH 2/2] SLM-OS Pi 5 SCR_EL3 sentinels (#134 Stage 2.5+ debug)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add memory-sentinel writes from two TF-A code paths so the kernel
can verify at boot:

  Sentinel A (setup_ns_context): writes 0xCAFE0001 + post-clear
    scr_el3 to NC_MEM_BASE+0xFEC0/FEC8. Proves the PLAT_RPI5 IRQ/FIQ
    clear actually ran AND captures the value going into the
    per-context register buffer.

  Sentinel B (cm_prepare_el3_exit_ns): writes 0xCAFE0002 + scr_el3
    read from the NS context to NC_MEM_BASE+0xFED0/FED8. This runs
    immediately before the assembly el3_exit loads scr_el3 via
    'msr scr_el3, x18'.

Bracketing the NS-context lifetime tells us:
  - A magic missing       → patched TF-A not loaded
  - A scr_el3 IRQ/FIQ set → our clear isn't taking effect
  - A != B                → an override path runs between the two writes

Each write is dc cvac'd to PoC + dsb sy so the kernel's NC mapping
reads land in DRAM. Slot addresses pinned in
kernel/include/diag_pi5.h on the SLM-OS side.

Both sentinels gated on PLAT_RPI5 only. Other TF-A platforms
unaffected.
---
 lib/el3_runtime/aarch64/context_mgmt.c | 44 ++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/lib/el3_runtime/aarch64/context_mgmt.c b/lib/el3_runtime/aarch64/context_mgmt.c
index e37bba41b..77e415587 100644
--- a/lib/el3_runtime/aarch64/context_mgmt.c
+++ b/lib/el3_runtime/aarch64/context_mgmt.c
@@ -393,6 +393,26 @@ static void setup_ns_context(cpu_context_t *ctx, const struct entry_point_info *
 	 */
 #ifdef PLAT_RPI5
 	scr_el3 &= ~((u_register_t)((1U << 1) | (1U << 2)));
+
+	/*
+	 * SLM-OS Sentinel A (#134 Stage 2.5+ debug). Write a magic word
+	 * plus the post-clear scr_el3 value to a known DRAM address so the
+	 * kernel can verify at boot:
+	 *   (a) magic = 0xCAFE0001 → this code path ran (PLAT_RPI5 was
+	 *       defined, setup_ns_context was reached for the NS context)
+	 *   (b) scr_el3 with bits 1 (IRQ) and 2 (FIQ) clear → our patch
+	 *       actually cleared them in the per-context register buffer
+	 *
+	 * 0xFFE0_FEC0 .. 0xFFE0_FED7 sits in the kernel's NC trace-slot
+	 * region (NC_MEM_BASE = 0xFFE00000 on Pi 5; offsets defined in
+	 * kernel/include/diag_pi5.h). Cache-clean to PoC so reads via the
+	 * kernel's Non-Cacheable mapping see the writes.
+	 */
+	*(volatile uint32_t *)0xFFE0FEC0ULL = 0xCAFE0001U;
+	*(volatile uint64_t *)0xFFE0FEC8ULL = (uint64_t)scr_el3;
+	__asm__ volatile("dc cvac, %0" :: "r"(0xFFE0FEC0ULL));
+	__asm__ volatile("dc cvac, %0" :: "r"(0xFFE0FEC8ULL));
+	__asm__ volatile("dsb sy" ::: "memory");
 #endif
 #endif
 
@@ -1789,6 +1809,30 @@ void cm_el2_sysregs_context_restore(uint32_t security_state)
  ******************************************************************************/
 void cm_prepare_el3_exit_ns(void)
 {
+#ifdef PLAT_RPI5
+	/*
+	 * SLM-OS Sentinel B (#134 Stage 2.5+ debug). Reads SCR_EL3 from
+	 * the NS context as it stands right before the assembly el3_exit
+	 * loads it via `msr scr_el3, x18`. Together with Sentinel A in
+	 * setup_ns_context this brackets the NS-context lifetime: if A
+	 * shows IRQ/FIQ clear but B shows them set, something between the
+	 * two writes overrode our clear. If both show clear, the SCR_EL3
+	 * value at NS-entry is what we expect and any irqtest hang must
+	 * be a different exception class.
+	 */
+	{
+		cpu_context_t *ns_ctx_for_sentinel = cm_get_context(NON_SECURE);
+		if (ns_ctx_for_sentinel != NULL) {
+			u_register_t scr_b = read_ctx_reg(
+				get_el3state_ctx(ns_ctx_for_sentinel), CTX_SCR_EL3);
+			*(volatile uint32_t *)0xFFE0FED0ULL = 0xCAFE0002U;
+			*(volatile uint64_t *)0xFFE0FED8ULL = (uint64_t)scr_b;
+			__asm__ volatile("dc cvac, %0" :: "r"(0xFFE0FED0ULL));
+			__asm__ volatile("dc cvac, %0" :: "r"(0xFFE0FED8ULL));
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+#endif
 #if (CTX_INCLUDE_EL2_REGS && IMAGE_BL31)
 #if ENABLE_ASSERTIONS
 	cpu_context_t *ctx = cm_get_context(NON_SECURE);
-- 
