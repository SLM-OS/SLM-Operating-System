# Makefile.test - Minimal x86-64 kernel build for boot testing
#
# This builds a standalone test kernel to verify x86-64 boot works.
# Once verified, the code will be integrated into the main build system.
#
# Usage:
#   make -f kernel/arch/x86_64/Makefile.test       # Build
#   make -f kernel/arch/x86_64/Makefile.test run   # Build and run in QEMU
#   make -f kernel/arch/x86_64/Makefile.test clean # Clean

# Tools
CC := gcc
AS := gcc
LD := ld
OBJCOPY := objcopy

# Directories
ROOT := $(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))/../../..
BUILD := $(ROOT)/build/x86_64-test
SRC_ARCH := $(ROOT)/kernel/arch/x86_64
SRC_DRV := $(ROOT)/kernel/drivers

# Output files
KERNEL_ELF := $(BUILD)/kernel-x86.elf
KERNEL_ISO := $(BUILD)/slmos-x86.iso
GRUB_CFG := $(BUILD)/boot/grub/grub.cfg

# GCC freestanding include directory (for stdint.h, stddef.h, etc.)
GCC_INCLUDE := $(shell gcc -print-file-name=include)

# Compiler flags
CFLAGS := -m64 -ffreestanding -nostdlib -nostdinc
CFLAGS += -isystem $(GCC_INCLUDE)
CFLAGS += -mno-red-zone -mno-sse -mno-sse2 -mno-mmx
CFLAGS += -fno-stack-protector -fno-pic
CFLAGS += -Wall -Wextra -std=c11
CFLAGS += -I$(ROOT)/kernel/include
CFLAGS += -DPLATFORM_X86_64=1

# Assembler flags
ASFLAGS := -m64

# Linker flags
LDFLAGS := -n -T $(ROOT)/kernel/kernel-x86_64.ld

# Object files
OBJS := $(BUILD)/trampoline32.o $(BUILD)/entry64.o $(BUILD)/idt_asm.o \
        $(BUILD)/main_x86.o $(BUILD)/idt.o

# QEMU
QEMU := qemu-system-x86_64
QEMU_FLAGS := -m 256M -no-reboot -no-shutdown

.PHONY: all run clean iso

all: $(KERNEL_ELF)

# Build kernel ELF
$(KERNEL_ELF): $(OBJS) $(ROOT)/kernel/kernel-x86_64.ld | $(BUILD)
	@echo "Linking $@..."
	$(LD) $(LDFLAGS) -o $@ $(OBJS)

# Compile 32-bit trampoline - must use -m32 to generate true 32-bit code
$(BUILD)/trampoline32.o: $(SRC_ARCH)/trampoline32.S | $(BUILD)
	@echo "Assembling $< (32-bit trampoline)..."
	$(CC) -c -m32 -I$(ROOT)/kernel/include -o $(BUILD)/trampoline32_temp.o $<
	$(OBJCOPY) -O elf64-x86-64 $(BUILD)/trampoline32_temp.o $@
	rm $(BUILD)/trampoline32_temp.o

# Compile 64-bit entry point
$(BUILD)/entry64.o: $(SRC_ARCH)/entry64.S | $(BUILD)
	@echo "Assembling $< (64-bit entry)..."
	$(CC) -c -m64 -I$(ROOT)/kernel/include -o $@ $<

# Compile 64-bit ISR stubs
$(BUILD)/idt_asm.o: $(SRC_ARCH)/idt.S | $(BUILD)
	@echo "Assembling $< (ISR stubs)..."
	$(CC) -c -m64 -o $@ $<

# Compile C files
$(BUILD)/main_x86.o: $(SRC_ARCH)/main_x86.c | $(BUILD)
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/idt.o: $(SRC_ARCH)/idt.c | $(BUILD)
	@echo "Compiling $<..."
	$(CC) $(CFLAGS) -c $< -o $@

# Create build directory
$(BUILD):
	mkdir -p $(BUILD)

# Create bootable ISO using GRUB (for QEMU -cdrom testing)
iso: $(KERNEL_ISO)

$(KERNEL_ISO): $(KERNEL_ELF) | $(BUILD)
	@echo "Creating bootable ISO..."
	mkdir -p $(BUILD)/boot/grub
	cp $(KERNEL_ELF) $(BUILD)/boot/kernel.elf
	@echo 'set timeout=0' > $(GRUB_CFG)
	@echo 'set default=0' >> $(GRUB_CFG)
	@echo '' >> $(GRUB_CFG)
	@echo 'menuentry "SLM-OS x86-64" {' >> $(GRUB_CFG)
	@echo '    multiboot2 /boot/kernel.elf' >> $(GRUB_CFG)
	@echo '    boot' >> $(GRUB_CFG)
	@echo '}' >> $(GRUB_CFG)
	grub-mkrescue -o $(KERNEL_ISO) $(BUILD) 2>/dev/null || \
		grub2-mkrescue -o $(KERNEL_ISO) $(BUILD) 2>/dev/null

# Create UEFI-bootable disk image (for real hardware via USB/SD card)
DISK_IMG := $(BUILD)/slmos-x86.img
GRUB_EFI := $(BUILD)/bootx64.efi
GRUB_EMBEDDED_CFG := $(BUILD)/grub-embed.cfg
ESP_DIR := $(BUILD)/esp

disk: $(DISK_IMG)

$(DISK_IMG): $(KERNEL_ELF) | $(BUILD)
	@echo "Creating UEFI-bootable disk image..."
	@# Step 1: Create embedded GRUB config (baked into EFI binary)
	@echo 'set timeout=0' > $(GRUB_EMBEDDED_CFG)
	@echo 'set default=0' >> $(GRUB_EMBEDDED_CFG)
	@echo 'insmod part_gpt' >> $(GRUB_EMBEDDED_CFG)
	@echo 'insmod fat' >> $(GRUB_EMBEDDED_CFG)
	@echo 'insmod multiboot2' >> $(GRUB_EMBEDDED_CFG)
	@echo 'insmod all_video' >> $(GRUB_EMBEDDED_CFG)
	@echo 'set gfxpayload=text' >> $(GRUB_EMBEDDED_CFG)
	@echo 'search --file --set=root /slmos/kernel.elf' >> $(GRUB_EMBEDDED_CFG)
	@echo 'multiboot2 /slmos/kernel.elf' >> $(GRUB_EMBEDDED_CFG)
	@echo 'boot' >> $(GRUB_EMBEDDED_CFG)
	@# Step 2: Build minimal GRUB EFI binary with embedded prefix config
	grub-mkimage -O x86_64-efi -o $(GRUB_EFI) \
		-p /boot/grub \
		-c $(GRUB_EMBEDDED_CFG) \
		part_gpt fat multiboot2 search serial all_video
	@# Step 3: Create ESP directory structure
	mkdir -p $(ESP_DIR)/EFI/BOOT
	mkdir -p $(ESP_DIR)/slmos
	cp $(GRUB_EFI) $(ESP_DIR)/EFI/BOOT/BOOTX64.EFI
	cp $(KERNEL_ELF) $(ESP_DIR)/slmos/kernel.elf
	@# Step 4: Create GPT disk image with EFI System Partition
	@# 64MB image — plenty for GRUB + kernel
	dd if=/dev/zero of=$(DISK_IMG) bs=1M count=64 status=none
	@# Create GPT with one EFI partition
	sgdisk --clear \
		--new=1:2048:131038 --typecode=1:EF00 --change-name=1:"EFI" \
		$(DISK_IMG) > /dev/null
	@# Format the EFI partition as FAT32
	@# Calculate partition offset: sector 2048 * 512 = 1048576
	LOOP=$$(sudo losetup --find --show --offset 1048576 --sizelimit $$((64*1024*1024 - 1048576)) $(DISK_IMG)) && \
	sudo mkfs.vfat -F 32 -n "SLMOS" $$LOOP > /dev/null && \
	sudo mount $$LOOP /mnt && \
	sudo cp -r $(ESP_DIR)/* /mnt/ && \
	sudo umount /mnt && \
	sudo losetup -d $$LOOP
	@echo "Created UEFI disk image: $(DISK_IMG)"
	@echo "Flash with: labctl sdwire flash test-pc $(DISK_IMG)"

# Run in QEMU with multiboot2 directly (no ISO needed)
run: $(KERNEL_ELF)
	@echo "Running x86-64 kernel in QEMU..."
	@echo "Press Ctrl+A then X to exit"
	$(QEMU) $(QEMU_FLAGS) \
		-kernel $(KERNEL_ELF)

# Run in QEMU with graphical display (to see framebuffer)
run-gui: $(KERNEL_ELF)
	@echo "Running x86-64 kernel in QEMU (GUI mode)..."
	$(QEMU) $(QEMU_FLAGS) \
		-kernel $(KERNEL_ELF) \
		-display gtk

# Run from ISO (for testing GRUB boot)
run-iso: $(KERNEL_ISO)
	@echo "Running x86-64 kernel from ISO..."
	$(QEMU) $(QEMU_FLAGS) \
		-cdrom $(KERNEL_ISO) \
		-display gtk

# Debug in QEMU with GDB
debug: $(KERNEL_ELF)
	@echo "Starting QEMU with GDB server on port 1234..."
	$(QEMU) $(QEMU_FLAGS) \
		-kernel $(KERNEL_ELF) \
		-s -S

# Connect GDB
gdb: $(KERNEL_ELF)
	gdb $(KERNEL_ELF) \
		-ex "target remote localhost:1234" \
		-ex "set disassembly-flavor intel"

# Clean
clean:
	rm -rf $(BUILD)

# ============================================================================
# Integrated kernel build (full SLM-OS with x86-64 platform layer)
# ============================================================================

BUILD_INT := $(ROOT)/build/x86_64-integrated
KERNEL_INT := $(BUILD_INT)/kernel-x86.elf

# Additional include paths for shared kernel
CFLAGS_INT := $(CFLAGS) -DSLM_INTEGRATED_BUILD \
              -I$(ROOT)/kernel/lib/littlefs -I$(ROOT)/kernel/tests -I$(ROOT)/kernel/gpu \
              -I$(ROOT)/kernel/include/compat \
              -DLFS_NO_MALLOC -DLFS_NO_ASSERT -DLFS_NO_DEBUG -DLFS_NO_WARN -DLFS_NO_ERROR

# Assembly objects (same as standalone)
OBJS_INT_ASM := $(BUILD_INT)/trampoline32.o $(BUILD_INT)/entry64.o \
                $(BUILD_INT)/idt_asm.o $(BUILD_INT)/context_x86.o

# x86-64 platform C sources
SRCS_INT_ARCH := $(SRC_ARCH)/idt.c $(SRC_ARCH)/pic.c $(SRC_ARCH)/acpi.c \
                 $(SRC_ARCH)/timer_x86.c $(SRC_ARCH)/platform_x86.c

# Shared kernel C sources
SRCS_INT_KERNEL := $(ROOT)/kernel/src/main.c \
                   $(ROOT)/kernel/src/panic.c \
                   $(ROOT)/kernel/src/kprintf.c \
                   $(ROOT)/kernel/src/string.c \
                   $(ROOT)/kernel/src/shell.c \
                   $(ROOT)/kernel/src/shell_sys.c \
                   $(ROOT)/kernel/src/shell_fs.c \
                   $(ROOT)/kernel/src/shell_exec.c \
                   $(ROOT)/kernel/src/shell_component.c \
                   $(ROOT)/kernel/src/vfs.c \
                   $(ROOT)/kernel/src/elf.c \
                   $(ROOT)/kernel/src/help.c \
                   $(ROOT)/kernel/src/semihosting.c \
                   $(ROOT)/kernel/src/slm_ffi.c \
                   $(ROOT)/kernel/sched/sched.c \
                   $(ROOT)/kernel/sched/task.c \
                   $(ROOT)/kernel/mm/pmm.c \
                   $(ROOT)/kernel/ipc/ipc.c \
                   $(ROOT)/kernel/ipc/pi_mutex.c \
                   $(ROOT)/kernel/drivers/uart_x86.c \
                   $(ROOT)/kernel/drivers/blkdev.c \
                   $(ROOT)/kernel/drivers/ramdisk.c \
                   $(ROOT)/kernel/gpu/gpu.c \
                   $(ROOT)/kernel/gpu/gpu_stub.c \
                   $(ROOT)/kernel/fs/littlefs_slm.c \
                   $(ROOT)/kernel/fs/littlefs_vfs.c \
                   $(ROOT)/kernel/lib/littlefs/lfs.c \
                   $(ROOT)/kernel/lib/littlefs/lfs_util.c

OBJS_INT_C := $(patsubst $(ROOT)/%.c,$(BUILD_INT)/%.o,$(SRCS_INT_ARCH) $(SRCS_INT_KERNEL))

OBJS_INT := $(OBJS_INT_ASM) $(OBJS_INT_C)

.PHONY: integrated run-int disk-int

integrated: $(KERNEL_INT)

LIBGCC := $(shell gcc -m64 -print-libgcc-file-name)

$(KERNEL_INT): $(OBJS_INT) $(ROOT)/kernel/kernel-x86_64.ld | $(BUILD_INT)
	@echo "Linking integrated kernel $@..."
	$(LD) -n -T $(ROOT)/kernel/kernel-x86_64.ld -o $@ $(OBJS_INT) $(LIBGCC)

# Assembly rules for integrated build
$(BUILD_INT)/trampoline32.o: $(SRC_ARCH)/trampoline32.S | $(BUILD_INT)
	@mkdir -p $(dir $@)
	$(CC) -c -m32 -I$(ROOT)/kernel/include -o $(BUILD_INT)/trampoline32_temp.o $<
	$(OBJCOPY) -O elf64-x86-64 $(BUILD_INT)/trampoline32_temp.o $@
	rm $(BUILD_INT)/trampoline32_temp.o

$(BUILD_INT)/entry64.o: $(SRC_ARCH)/entry64.S | $(BUILD_INT)
	@mkdir -p $(dir $@)
	$(CC) -c -m64 -I$(ROOT)/kernel/include -o $@ $<

$(BUILD_INT)/idt_asm.o: $(SRC_ARCH)/idt.S | $(BUILD_INT)
	@mkdir -p $(dir $@)
	$(CC) -c -m64 -o $@ $<

$(BUILD_INT)/context_x86.o: $(SRC_ARCH)/context.S | $(BUILD_INT)
	@mkdir -p $(dir $@)
	$(CC) -c -m64 -o $@ $<

# Pattern rule for C files in the integrated build
$(BUILD_INT)/%.o: $(ROOT)/%.c | $(BUILD_INT)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_INT) -c $< -o $@

$(BUILD_INT):
	mkdir -p $(BUILD_INT)

# Run integrated kernel in QEMU
run-int: $(KERNEL_INT)
	@echo "Running integrated x86-64 kernel in QEMU..."
	@echo "Press Ctrl+A then X to exit"
	$(QEMU) $(QEMU_FLAGS) \
		-kernel $(KERNEL_INT) \
		-serial stdio \
		-display none

# Create UEFI disk image for integrated kernel
DISK_IMG_INT := $(BUILD_INT)/slmos-x86.img

disk-int: $(KERNEL_INT)
	@echo "Creating UEFI-bootable disk image (integrated)..."
	@echo 'set timeout=0' > $(BUILD_INT)/grub-embed.cfg
	@echo 'set default=0' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'insmod part_gpt' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'insmod fat' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'insmod multiboot2' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'insmod all_video' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'set gfxpayload=text' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'search --file --set=root /slmos/kernel.elf' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'multiboot2 /slmos/kernel.elf' >> $(BUILD_INT)/grub-embed.cfg
	@echo 'boot' >> $(BUILD_INT)/grub-embed.cfg
	grub-mkimage -O x86_64-efi -o $(BUILD_INT)/bootx64.efi \
		-p /boot/grub -c $(BUILD_INT)/grub-embed.cfg \
		part_gpt fat multiboot2 search serial all_video
	mkdir -p $(BUILD_INT)/esp/EFI/BOOT $(BUILD_INT)/esp/slmos
	cp $(BUILD_INT)/bootx64.efi $(BUILD_INT)/esp/EFI/BOOT/BOOTX64.EFI
	cp $(KERNEL_INT) $(BUILD_INT)/esp/slmos/kernel.elf
	dd if=/dev/zero of=$(DISK_IMG_INT) bs=1M count=64 status=none
	sgdisk --clear --new=1:2048:131038 --typecode=1:EF00 --change-name=1:"EFI" \
		$(DISK_IMG_INT) > /dev/null
	LOOP=$$(sudo losetup --find --show --offset 1048576 --sizelimit $$((64*1024*1024 - 1048576)) $(DISK_IMG_INT)) && \
	sudo mkfs.vfat -F 32 -n "SLMOS" $$LOOP > /dev/null && \
	sudo mount $$LOOP /mnt && \
	sudo cp -r $(BUILD_INT)/esp/* /mnt/ && \
	sudo umount /mnt && \
	sudo losetup -d $$LOOP
	@echo "Created: $(DISK_IMG_INT)"

# Show help
help:
	@echo "x86-64 Boot Test Makefile"
	@echo "========================="
	@echo ""
	@echo "Targets:"
	@echo "  all      - Build kernel ELF (default)"
	@echo "  run      - Build and run in QEMU (text mode)"
	@echo "  run-gui  - Build and run in QEMU (GUI mode, shows framebuffer)"
	@echo "  iso      - Create bootable ISO with GRUB (QEMU only)"
	@echo "  run-iso  - Run from ISO in QEMU"
	@echo "  disk     - Create UEFI-bootable disk image (for real hardware)"
	@echo "  integrated - Build integrated SLM-OS kernel for x86-64"
	@echo "  run-int  - Run integrated kernel in QEMU"
	@echo "  disk-int - Create UEFI disk image (integrated)"
	@echo "  debug    - Run QEMU with GDB server"
	@echo "  gdb      - Connect GDB to running QEMU"
	@echo "  clean    - Remove build artifacts"
	@echo "  help     - Show this help"
